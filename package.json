        "laravel-mix": "^4.0.7",
        "lodash": "^4.17.11",
        "popper.js": "^1.12",
        "resolve-url-loader": "^2.3.1",
        "sass": "^1.15.2",
        "sass-loader": "^7.1.0",
        "vue": "^2.5.17",
        "vue-template-compiler": "^2.6.10"
    },
    "dependencies": {
        "ace-builds": "^1.4.3",
        "blueimp-gallery": "^2.33.0",
        "github-markdown-css": "^3.0.1",
        "highlight.js": "^9.15.6",
        "marked": "^0.6.2",
        "mermaid": "^8.1.0",
        "node-emoji": "^1.10.0",
        "nomnoml": "^0.6.1",
